<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Video Preview Container: Left major area in landscape (LIVE-05) -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/side_controls_container">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false"
            app:surface_type="surface_view" />

        <!-- Overlay for stream interrupted / offline state -->
        <LinearLayout
            android:id="@+id/stream_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D0101418"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pb_stream_loading"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_teal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_stream_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:text="即時串流連線中 / 暫無影像"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_stream"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/surface_elevated"
                android:minHeight="48dp"
                android:text="@string/btn_retry_connect"
                android:textColor="@color/accent_teal"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Speedometer HUD in top-left of video preview -->
        <LinearLayout
            android:id="@+id/hud_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_status_badge"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hud_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/hud_speed_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hud_gps_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_gps_searching"
                android:textColor="@color/accent_teal"
                android:textSize="11sp" />

            <!-- PiP visible recording dot & battery status -->
            <LinearLayout
                android:id="@+id/hud_pip_status_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_hud_record_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/ic_recording_dot"
                    android:contentDescription="HUD錄影指示" />

                <TextView
                    android:id="@+id/tv_hud_record_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="未錄影"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_hud_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/battery_cd_unknown"
                    android:src="@drawable/ic_battery_unknown" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fullscreen Switch Button in sidebar -->
        <ImageButton
            android:id="@+id/btn_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_enter_fullscreen"
            android:padding="12dp"
            android:src="@drawable/ic_live_fullscreen"
            app:tint="@color/text_primary" />
        <!-- Compact Floating Status Strip at bottom of preview in landscape -->
        <LinearLayout
            android:id="@+id/status_strip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_status_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/iv_record_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/ic_recording_dot"
                android:contentDescription="@string/recording_active" />

            <TextView
                android:id="@+id/tv_record_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:text="@string/recording_stopped"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/battery_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_battery_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/battery_cd_unknown"
                    android:src="@drawable/ic_battery_unknown" />

                <TextView
                    android:id="@+id/tv_battery_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:visibility="gone"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sd_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:text="@string/sd_remaining_unknown"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Side Control Bar on Right (Width: 72dp, LIVE-05) -->
    <LinearLayout
        android:id="@+id/side_controls_container"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:background="@color/surface_dark"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">



        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 1. Ensure Recording Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_recording"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginVertical="6dp"
            android:backgroundTint="@color/accent_teal"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:text="錄影"
            android:textColor="@color/bg_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <!-- 2. Snapshot Photo Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_snapshot"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginVertical="6dp"
            android:backgroundTint="@color/surface_elevated"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:text="拍照"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <!-- 3. More Actions Button (Opens PopupMenu: PiP, Fullscreen, etc.) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_more_options"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginVertical="6dp"
            android:backgroundTint="@color/surface_dark"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:padding="0dp"
            android:text="更多"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
