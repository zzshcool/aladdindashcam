<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingBottom="@dimen/space_24">

        <!-- 54dp Compact Header (D02 / D05 / D11) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_compact"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_manage_recorders"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/home_title_my_dashcam"
                android:textSize="@dimen/text_size_h1"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/home_title_my_dashcam" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_recorder"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:minWidth="@dimen/touch_target_min"
                android:padding="0dp"
                android:text="@string/home_action_add_recorder"
                android:textSize="24sp"
                android:textColor="@color/accent_blue"
                android:contentDescription="@string/home_action_add_recorder_desc" />
        </LinearLayout>

        <!-- Empty Device Guidance State (Visible when no devices exist) -->
        <LinearLayout
            android:id="@+id/layout_empty_guidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_20"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_recorder_hero"
                android:contentDescription="@string/home_hero_desc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/home_headline_ready"
                android:textSize="@dimen/text_size_h2"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/home_subhead_guide"
                android:textSize="@dimen/text_size_sub"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Primary Active DashCam Card (Review Section 4: Device Card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_home_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardBackgroundColor="@color/surface_dark"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_subtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_16"
                android:orientation="vertical">

                <!-- Header Row: Small Device Silhouette + Name/Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Small Brand Silhouette Graphic (Review Section 4: Do not hide device illustration) -->
                    <ImageView
                        android:id="@+id/iv_card_device_icon"
                        android:layout_width="48dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_recorder_hero"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_home_device"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_device_none"
                            android:textSize="@dimen/text_size_h2"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tv_home_connection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/home_device_none_desc"
                            android:textSize="@dimen/text_size_sub"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Telemetry Row: Battery & SD Status (Review Section 4 & D09) -->
                <LinearLayout
                    android:id="@+id/layout_device_telemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_status_badge"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <!-- Battery info with clean text & accessibility (D09) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_telemetry_battery"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_battery_unknown"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_home_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:textSize="@dimen/text_size_sub"
                            android:textColor="@color/text_primary"
                            tools:text="電量 4/4" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/border_subtle" />

                    <!-- SD info with clean text & capacity (D09) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_storage_normal"
                            app:tint="@color/text_secondary"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_home_sd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:textSize="@dimen/text_size_sub"
                            android:textColor="@color/text_primary"
                            android:maxLines="4"
                            tools:text="SD：可錄 120 分" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Primary Action CTA (Review Section 3: Solid Cool Blue Button) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_home_connect"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_primary"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/home_action_add"
                    android:textAllCaps="false"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_button"
                    android:backgroundTint="@color/accent_blue"
                    android:textColor="@color/accent_blue_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Riding Map Card (Review Section 4: Map Entry, Always accessible offline) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_home_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardBackgroundColor="@color/surface_dark"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_subtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_16"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_my_location"
                    app:tint="@color/accent_blue"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_map_title"
                        android:textSize="@dimen/text_size_h2"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_map_desc"
                        android:textSize="@dimen/text_size_caption"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Neutral Chevron (D01: Neutral arrows, not accent) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Access Shortcuts (Review Section 4: Local Video & Downloads) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_home_local_album"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_4"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardBackgroundColor="@color/surface_dark"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_subtle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_quick_album"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_quick_album_desc"
                        android:textSize="@dimen/text_size_caption"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_home_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardBackgroundColor="@color/surface_dark"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_subtle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_12"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_quick_downloads"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/downloads_guide"
                        android:textSize="@dimen/text_size_caption"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Brand Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/home_brand_footer"
            android:gravity="center"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/text_disabled" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
