<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Video Preview Container (16:9 aspect ratio preservation) -->
    <!-- Top Device Header Bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_device_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aladdin B1 行車記錄器"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_top_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="裝置已連線"
            android:textColor="@color/accent_teal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Video Preview Container (Adaptive 16:9 within available space) -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toTopOf="@id/status_strip">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:surface_type="surface_view" />

        <!-- Overlay for stream interrupted / offline state -->
        <LinearLayout
            android:id="@+id/stream_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D0101418"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_stream_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="即時串流連線中 / 暫無影像"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_stream"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/surface_elevated"
                android:text="@string/btn_retry_connect"
                android:textColor="@color/accent_teal"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Speedometer HUD in top-left of video preview -->
        <LinearLayout
            android:id="@+id/hud_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_status_badge"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hud_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00"
                    android:textColor="@color/text_primary"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/hud_speed_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hud_gps_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_gps_searching"
                android:textColor="@color/accent_teal"
                android:textSize="11sp" />

            <!-- PiP visible recording dot & battery status -->
            <LinearLayout
                android:id="@+id/hud_pip_status_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_hud_record_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_recording_dot"
                    android:contentDescription="HUD錄影指示" />

                <TextView
                    android:id="@+id/tv_hud_record_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="未錄影"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_hud_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="電量4"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Dashcam Device Status Strip (Directly below preview) -->
    <LinearLayout
        android:id="@+id/status_strip"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/action_buttons_container">

        <!-- Recording Indicator with clear text & icon -->
        <ImageView
            android:id="@+id/iv_record_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_recording_dot"
            android:contentDescription="@string/recording_active" />

        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/recording_stopped"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Battery Level -->
        <TextView
            android:id="@+id/tv_battery_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="電量: 等級4"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- SD Card Remaining Time -->
        <TextView
            android:id="@+id/tv_sd_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩餘: 130分"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Primary Rider Action Buttons -->
    <LinearLayout
        android:id="@+id/action_buttons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Main Ride Navigation PiP Mode Button (52dp target, high contrast) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pip_navigation"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/accent_teal"
            android:text="開始導航 (開啟子母畫面 PiP)"
            android:textColor="@color/bg_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Snapshot Photo Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_snapshot"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/surface_elevated"
                android:text="@string/btn_take_photo"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <!-- Ensure Recording Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_recording"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/surface_elevated"
                android:text="開始錄影"
                android:textColor="@color/accent_teal"
                android:textSize="14sp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
