<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Video Preview Container (16:9 aspect ratio preservation) -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:surface_type="surface_view" />

        <!-- Overlay for stream interrupted / offline state -->
        <LinearLayout
            android:id="@+id/stream_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A0101418"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_stream_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_status_stream_interrupted"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_retry_stream"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/surface_elevated"
                android:text="@string/btn_retry_connect"
                android:textColor="@color/accent_teal" />
        </LinearLayout>

        <!-- Speedometer HUD in top-left of video preview -->
        <LinearLayout
            android:id="@+id/hud_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_status_badge"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hud_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00"
                    android:textColor="@color/text_primary"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/hud_speed_unit"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hud_gps_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_gps_searching"
                android:textColor="@color/accent_teal"
                android:textSize="11sp" />

            <!-- PiP visible recording dot & battery status (C10) -->
            <LinearLayout
                android:id="@+id/hud_pip_status_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_hud_record_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_recording_dot"
                    android:contentDescription="HUD錄影指示" />

                <TextView
                    android:id="@+id/tv_hud_record_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="停錄"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_hud_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="電量4"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Dashcam Device Status Strip (Directly below preview) -->
    <LinearLayout
        android:id="@+id/status_strip"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preview_container">

        <!-- Recording Indicator -->
        <ImageView
            android:id="@+id/iv_record_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_recording_dot"
            android:contentDescription="@string/recording_active" />

        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/recording_stopped"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Battery Level -->
        <TextView
            android:id="@+id/tv_battery_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="電量: 等級4"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- SD Card Remaining Time -->
        <TextView
            android:id="@+id/tv_sd_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩餘: 130分"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Primary Rider Action Buttons -->
    <LinearLayout
        android:id="@+id/action_buttons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_strip">

        <!-- Ensure Recording Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_recording"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/accent_teal"
            android:text="@string/btn_start_recording"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Snapshot Photo Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_snapshot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/surface_elevated"
                android:text="@string/btn_take_photo"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:cornerRadius="10dp" />

            <!-- Navigation Mode PiP Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pip_navigation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/surface_elevated"
                android:text="@string/btn_navigation_mode"
                android:textColor="@color/accent_teal"
                android:textSize="15sp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Telemetry Diagnostic Info Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/action_buttons_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="即時通訊與通道資訊"
                android:textColor="@color/accent_teal"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_telemetry_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="控制通道：192.168.25.1:8081 (GPSOCKET TCP)\n串流端點：rtsp://192.168.25.1:8080/?action=stream\n裝置型號：GoPlus / Generalplus B1 系列\n網路狀態：專屬 Wi-Fi 已綁定"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
