<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/map_split_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Video Preview Container (Adaptive Fit in all available space, LIVE-01 / LIVE-04) -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_live_mode_toggle"
        app:layout_constraintBottom_toTopOf="@id/status_strip">

        <android.opengl.GLSurfaceView
            android:id="@+id/gl_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Overlay for stream interrupted / offline state -->
        <LinearLayout
            android:id="@+id/stream_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D0101418"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pb_stream_loading"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent_teal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_stream_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:gravity="center"
                android:text="@string/live_connecting_to_stream_no_video_yet"
                android:textSize="14sp"
        android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_stream"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/surface_elevated"
                android:minHeight="48dp"
                android:text="@string/btn_retry_connect"
                android:textColor="@color/accent_teal"
                app:cornerRadius="@dimen/radius_button" />
        </LinearLayout>

        <!-- Speedometer HUD in top-left of video preview -->
        <LinearLayout
            android:id="@+id/hud_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_status_badge"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_hud_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/hud_speed_unit"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_hud_gps_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_gps_searching"
                android:textColor="@color/accent_teal"
                android:textSize="@dimen/text_size_caption" />

            <!-- PiP visible recording dot & battery status -->
            <LinearLayout
                android:id="@+id/hud_pip_status_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_hud_record_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/ic_recording_dot"
                    android:contentDescription="@string/live_recording_indicator" />

                <TextView
                    android:id="@+id/tv_hud_record_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/live_not_recording"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_caption" />

                <ImageView
                    android:id="@+id/iv_hud_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/battery_cd_unknown"
                    android:src="@drawable/ic_battery_unknown" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fullscreen Switch Button in top-right of preview (48x48dp touch area) -->
        <ImageButton
            android:id="@+id/btn_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_enter_fullscreen"
            android:padding="12dp"
            android:src="@drawable/ic_live_fullscreen"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Compact Dashcam Device Status Strip (Directly below preview, 32dp) -->
    <LinearLayout
        android:id="@+id/status_strip"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="#B3101418"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_normal_controls">

        <ImageView
            android:id="@+id/iv_record_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_recording_dot"
            android:contentDescription="@string/recording_active" />

        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/recording_stopped"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/battery_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_battery_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/battery_cd_unknown"
                android:src="@drawable/ic_battery_unknown" />

            <TextView
                android:id="@+id/tv_battery_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:visibility="gone"
                android:text=""
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sd_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/white"
            android:text="@string/sd_remaining_unknown"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mode Toggle: Normal Preview vs Ride Mode -->
    <LinearLayout
        android:id="@+id/layout_live_mode_toggle"
        android:layout_width="0dp"
        android:layout_marginHorizontal="12dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="48dp"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_live_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            app:checkedButton="@id/btn_mode_normal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_normal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/live_video"
                android:textSize="12sp"
                android:backgroundTint="@color/transparent"
                app:strokeWidth="1dp"
                android:textColor="@color/text_secondary"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_split"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/live_split"
                android:textSize="12sp"
                android:backgroundTint="@color/transparent"
                app:strokeWidth="1dp"
                android:textColor="@color/text_secondary"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_map"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/live_map"
                android:textSize="12sp"
                android:backgroundTint="@color/transparent"
                app:strokeWidth="1dp"
                android:textColor="@color/text_secondary"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_ride"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/live_ride"
                android:textSize="12sp"
                android:backgroundTint="@color/transparent"
                app:strokeWidth="1dp"
                android:textColor="@color/text_secondary"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- Normal Preview Controls Container -->
    <LinearLayout
        android:id="@+id/layout_normal_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Compact Single-Row Action Buttons (52dp, LIVE-03) -->
        <LinearLayout
            android:id="@+id/action_buttons_container"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_height="48dp"
            android:layout_marginTop="0dp">

            <!-- 1. Ensure Recording Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_recording"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_start_recording_compact"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/radius_button"
                android:backgroundTint="@color/transparent"
                app:strokeWidth="0dp"
                android:textColor="@color/text_secondary"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:paddingHorizontal="8dp"
                android:contentDescription="@string/btn_start_recording" />

            <!-- 2. Snapshot Photo Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_snapshot"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="@string/btn_take_photo"
                android:textSize="13sp"
                app:cornerRadius="@dimen/radius_button"
                android:backgroundTint="@color/transparent"
                app:strokeWidth="0dp"
                android:textColor="@color/text_secondary"
                android:minHeight="48dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:paddingHorizontal="8dp" />

            <!-- 3. More Actions Button (Opens PopupMenu: PiP, Fullscreen, etc.) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_more_options"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                app:cornerRadius="@dimen/radius_button"
                app:strokeColor="@color/border_subtle"
                android:backgroundTint="@color/transparent"
                app:strokeWidth="0dp"
                android:textColor="@color/text_secondary"
                android:minHeight="48dp"
                android:text="⋯"
                android:textSize="24sp"
                android:contentDescription="@string/btn_more_options"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/live_view_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
        android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_live_expand"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/live_expand"
                android:textSize="13sp"
                android:textColor="@color/accent_teal"
                app:cornerRadius="@dimen/radius_button"
                app:strokeColor="@color/border_subtle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_live_pip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/live_pip"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="@dimen/radius_button"
                app:strokeColor="@color/border_subtle" />
        </LinearLayout>
    </LinearLayout>

    <!-- Full GPS Ride Mode HUD (Speedometer Gauge + Altitude + Bearing + G-Force) -->
    <LinearLayout
        android:id="@+id/layout_ride_mode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/bg_dark"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_live_mode_toggle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Speed Gauge View (Center stage) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.aladdin.dashcam.ui.SpeedGaugeView
                android:id="@+id/speed_gauge"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_ride_gps_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:text="@string/live_source_phone_gps"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />
        </FrameLayout>

        <!-- Metric Cards: Altitude, Ascent, Bearing, G-Force -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <!-- 1. Altitude -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"

                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_altitude"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tv_ride_altitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="-- m"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Ascent -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"

                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_ascent"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tv_ride_ascent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="+0 m"
                    android:textColor="@color/accent_teal"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Bearing / Compass -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"

                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_heading"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tv_ride_bearing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="--°"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. Acceleration G-Force -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"

                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ride_gforce_short"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tv_ride_gforce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="-- G"
                    android:textColor="@color/warning_yellow"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Google Maps Container (For Split & Map modes) -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_live_mode_toggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/status_strip">

        <com.google.android.gms.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_map_type"
            style="@style/Widget.MaterialComponents.Button" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_gravity="top|end" android:layout_margin="10dp" android:text="@string/live_satellite"
            android:backgroundTint="@color/surface_dark" android:textColor="@color/text_primary" app:cornerRadius="24dp"
                android:visibility="gone" />

        <!-- Floating map header badge: Phone GPS status & Latency disclaimer -->
        <LinearLayout
            android:id="@+id/map_disclaimer_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_status_badge"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tv_map_gps_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_phone_gps_not_frame_synced_with"
                android:textColor="@color/accent_teal"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_map_speed_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_speed_km_h_accuracy_m"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>

        <!-- Floating map controls: Re-center & Clear Trajectory & Quick Actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:layout_marginBottom="36dp"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Floating Record Action Button on Map -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_map_record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/btn_start_recording_compact"
                app:backgroundTint="@color/accent_teal"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_recording_dot"
                app:tint="@color/bg_dark"
                android:visibility="gone" />

            <!-- Floating Snapshot Action Button on Map -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_map_snapshot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/btn_take_photo"
                app:backgroundTint="@color/surface_elevated"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_camera_white"
                app:tint="@color/text_primary"
                android:visibility="gone" />

            <!-- Floating Clear Trajectory Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_clear_trajectory"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/surface_dark"
                android:paddingHorizontal="10dp"
                android:text="@string/live_reset_route"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption"
                app:cornerRadius="18dp"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                android:visibility="gone" />

            <!-- Floating Follow / Center Location Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_map_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/live_my_location"
                app:backgroundTint="@color/surface_elevated"
                app:fabSize="mini"
                app:ensureMinTouchTargetSize="true"
                app:srcCompat="@drawable/ic_my_location"
                app:tint="@color/accent_teal" />
        </LinearLayout>

        <!-- Dual-Network Notice Banner -->
        <TextView
            android:id="@+id/tv_map_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@color/surface_dark"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="@string/live_recorder_uses_wi_fi_maps_need"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
