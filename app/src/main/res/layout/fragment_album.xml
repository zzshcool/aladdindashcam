<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Album List View Hierarchy -->
    <LinearLayout
        android:id="@+id/layout_album_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Control Layer 1: Source Selector (Left) & Batch Select (Right) (D10) -->
        <LinearLayout
            android:id="@+id/layout_normal_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@color/surface_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_album_source"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btn_source_device"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_source_device"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/album_source_device"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:strokeWidth="0dp"
                    android:backgroundTint="@color/transparent"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_source_local"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/album_source_local"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:strokeWidth="0dp"
                    android:backgroundTint="@color/transparent"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:elevation="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Enter Batch Selection Mode Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_enter_select"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/album_select"
                android:textColor="@color/accent_blue"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_album_recording_paused"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_elevated"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/album_recording_paused_resumes_when_you_leave"
            android:textColor="@color/warning_yellow"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Batch Selection Action Header (Visible only during batch mode) -->
        <LinearLayout
            android:id="@+id/layout_batch_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/surface_elevated"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch_select_all"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/album_select_all"
                android:textColor="@color/accent_blue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_batch_selected_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/album_selected_mb"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/album_done"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Top Control Layer 2: Filter Chips (Left) + View Mode Switch (Right) (D10) -->
        <LinearLayout
            android:id="@+id/layout_filter_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_album_sort"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:minWidth="48dp" android:text="@string/album_sort"
                android:textAllCaps="false" />

            <HorizontalScrollView
                android:id="@+id/scroll_filter_chips"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/filter_chips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_status_badge"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/album_filter_all"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/filter_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/album_filter_video"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/filter_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/album_filter_photo"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/filter_emergency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/album_filter_emergency"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- View Mode Switch: Grid vs Timeline -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_view_mode"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btn_mode_grid"
                app:singleSelection="true"
                android:layout_width="wrap_content"
                android:layout_marginBottom="0dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_grid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/text_primary"
                    android:layout_width="48dp"
                    android:text="▦"
                    android:textSize="18sp"
                    android:contentDescription="@string/album_view_grid"
                    app:strokeWidth="0dp"
                    android:backgroundTint="@color/transparent"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_timeline"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:insetTop="0dp" android:insetBottom="0dp"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/text_primary"
                    android:layout_width="48dp"
                    android:text="≡"
                    android:textSize="18sp"
                    android:contentDescription="@string/album_view_timeline"
                    app:strokeWidth="0dp"
                    android:backgroundTint="@color/transparent"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:elevation="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Media Content List & State Containers -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1. Grid List View -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_album"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp" />

            <!-- 2. Interactive Timeline View -->
            <LinearLayout
                android:id="@+id/layout_timeline_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/bg_dark"
                android:visibility="gone">

                <!-- Date selector chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@color/surface_dark"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/container_timeline_dates"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp" />
                </HorizontalScrollView>

                <!-- Status indicator: Green for regular, Red for emergency -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/accent_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/album_loop_recordings"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/error_red" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/album_protected_events"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Timeline Ruler View -->
                <com.aladdin.dashcam.ui.TimelineRulerView
                    android:id="@+id/timeline_ruler"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/surface_dark" />

                <!-- Timeline Seek Details & Quick Jump -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp">

                    <TextView
                        android:id="@+id/tv_timeline_cursor_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/album_drag_the_timeline_to_find_a"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_timeline_segment_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_timeline_play"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:enabled="false"
                            android:text="@string/timeline_play_selected" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_timeline_jump_next"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/timeline_next_segment"
                        android:textColor="@color/accent_teal"
                        android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <ListView
                    android:id="@+id/list_timeline_segments"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:divider="@color/border_subtle"
                    android:dividerHeight="1dp" />
            </LinearLayout>

            <!-- Empty / Unqueried State View -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_album_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/album_recorder_connected_load_the_video_list"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_album"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/surface_elevated"
                        android:text="@string/album_load_recorder_videos"
                        android:textColor="@color/accent_teal"
                        app:cornerRadius="@dimen/radius_button" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Loading State View -->
            <LinearLayout
                android:id="@+id/layout_loading_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/accent_teal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/album_loading"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Batch Selection Bottom Action Bar (Download & Delete) -->
        <LinearLayout
            android:id="@+id/layout_batch_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch_download"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_teal"
                android:text="@string/album_download_selected"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                app:cornerRadius="@dimen/radius_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch_delete"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/error_red"
                android:text="@string/album_delete_selected"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:cornerRadius="@dimen/radius_button" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen Media Viewer Overlay (Playback & Photo Viewer) -->
    <FrameLayout
        android:id="@+id/layout_media_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:background="@color/black">

        <!-- FFmpeg video surface for device and local media -->
        <android.opengl.GLSurfaceView
            android:id="@+id/gl_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Photo View for Images (Pinch to zoom supported) -->
        <ImageView
            android:id="@+id/iv_photo_viewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/album_photo_viewer"
            android:scaleType="matrix"
            android:visibility="gone" />

        <!-- Adjacent Segments Thumbnail Strip (Bottom overlay on player) -->
        <LinearLayout
            android:id="@+id/layout_viewer_strip_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B311161B"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/album_nearby_video_segments"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_caption" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_viewer_strip"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_viewer_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#D911161B"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_video_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_video_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/album_pause"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="@color/white"
                    android:minWidth="64dp"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:elevation="0dp" />

                <SeekBar
                    android:id="@+id/seek_video"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/album_local_video_position"
                    android:max="1000" />
            </LinearLayout>
        </LinearLayout>

        <!-- Viewer Top Bar (Back button, File title, Recording time, Independent Download button) -->
        <LinearLayout
            android:id="@+id/viewer_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#D911161B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="0dp"
            android:minHeight="56dp">

            <ImageButton
                android:id="@+id/btn_viewer_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/album_back_to_album"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_viewer_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_viewer_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/album_time_unknown"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_viewer_segments" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp"
                android:padding="0dp" android:text="▤" android:textSize="18sp" android:textColor="@color/white"
                android:contentDescription="@string/viewer_segments"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_viewer_more" style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp"
                android:padding="0dp" android:text="⋯" android:textSize="18sp" android:textColor="@color/white"
                android:contentDescription="@string/video_tools" android:textAllCaps="false" />

            <!-- Independent Download Button on Viewer Top Bar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_viewer_download"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:minWidth="0dp"
                android:contentDescription="@string/album_download"
                android:textSize="12sp"
                app:cornerRadius="@dimen/radius_button"
                android:backgroundTint="@color/transparent"
                android:textColor="@color/white"
                app:icon="@drawable/ic_tab_downloads"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>

        <!-- Loading Overlay (Presents preview loading / download progress) -->
        <LinearLayout
            android:id="@+id/viewer_loading_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#E6161E23"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/accent_teal" />

            <TextView
                android:id="@+id/tv_viewer_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/album_loading_preview"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Error / Retry Overlay -->
        <LinearLayout
            android:id="@+id/viewer_error_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#E6161E23"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_viewer_error_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/album_unable_to_load_media"
                android:textColor="@color/error_red"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_viewer_retry"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/surface_elevated"
                android:text="@string/album_retry"
                android:textColor="@color/accent_teal"
                app:cornerRadius="@dimen/radius_button"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
