<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AladdinDashCam.Launcher" parent="Theme.AladdinDashCam">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="Theme.AladdinDashCam" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Accent Color (Cool Blue, Review Section 3) -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
        <item name="colorOnPrimary">@color/accent_blue_dark</item>

        <!-- Secondary Accent Color -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue_dark</item>
        <item name="colorOnSecondary">@color/accent_blue_dark</item>

        <!-- Status & Navigation Bar (Graphite Dark) -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Standard Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
