<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: Enforce TLS for public external internet (Maps, CDNs, external APIs) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- DashCam Local Network: Allow cleartext traffic for dashcam local private IPs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.25.1</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.43.1</domain>
        <domain includeSubdomains="true">192.168.50.1</domain>
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">172.16.0.1</domain>
    </domain-config>
</network-security-config>
